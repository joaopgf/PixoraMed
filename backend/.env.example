# Modelo das variáveis do backend. Copie para backend/.env (que fica fora do git) e preencha.
# Em produção (Render), as mesmas variáveis vêm do Terraform; o .env não é usado.

# [obrigatória] Endereço JDBC do PostgreSQL.
# Local (docker compose da pasta infra): jdbc:postgresql://localhost:5432/pixoramed
# Produção (Neon): jdbc:postgresql://<host-do-neon>/<banco>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/pixoramed
# [obrigatória] Usuário e senha do banco. Local: os mesmos do infra/.env
DATABASE_USERNAME=pixoramed
DATABASE_PASSWORD=troque-esta-senha

# [obrigatória] Chave que assina os tokens de login, com pelo menos 32 caracteres.
# Gere uma com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-ou-mais-caracteres
# [opcional] Validade do login em horas (padrão 8)
JWT_EXPIRATION_HOURS=8

# [obrigatória] Endereços do frontend que podem chamar a API, separados por vírgula.
# Local: http://localhost:5173 · Produção: o endereço do site na Vercel
CORS_ALLOWED_ORIGINS=http://localhost:5173

# [obrigatória] Microsserviço de IA. O token precisa ser igual ao AI_SERVICE_TOKEN do ai-service.
# Local: http://localhost:8001 · Produção: o endereço do ai-service no Render
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=troque-por-um-token-aleatorio
# [opcional] Tempo máximo de espera pela IA, em segundos (padrão 120; no Render gratuito ela pode estar dormindo)
AI_SERVICE_TIMEOUT_SECONDS=120

# [opcional] Abaixo desta confiança o resultado é "inconclusive" (padrão 0.8)
INCONCLUSIVE_THRESHOLD=0.8
# [opcional] Importa o training-results.csv ao iniciar, só acrescentando linhas novas (padrão true)
IMPORT_TRAININGS_ON_STARTUP=true
