# Modelo das variáveis do docker compose (só desenvolvimento local).
# Copie para infra/.env (que fica fora do git) e troque os valores. Produção não usa este arquivo.

# [obrigatórias] Banco PostgreSQL local criado pelo container "db"
POSTGRES_DB=pixoramed
POSTGRES_USER=pixoramed
POSTGRES_PASSWORD=troque-esta-senha
# [opcional] Porta do Postgres no seu computador (padrão 5432; use 5433 se já tiver um Postgres instalado)
DB_PORT=5432

# [obrigatória] Chave que assina os tokens de login, com pelo menos 32 caracteres
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-ou-mais-caracteres

# [obrigatória] Token interno entre backend e ai-service (o mesmo valor vai para os dois)
AI_SERVICE_TOKEN=troque-por-um-token-aleatorio
