ion id="lc_association_9115131a256655608e55c223f194604e11e30a7d8e0527503915c4660cf8e01a" associationDirection="None" sourceRef="lc_activity_c8814c70fef48fc9b4b81b2fa4bdc0e8b4201b62f471da15d79512ef410866b2" targetRef="lc_textAnnotation_9115131a256655608e55c223f194604e11e30a7d8e0527503915c4660cf8e01a" /><bpmn:association id="lc_association_442ac8ae35e4c6e53eef6013133c9feaade8fee2b5d121cb34b0ce8a1b5d53cb" associationDirection="None" sourceRef="lc_activity_dc0ddad03e79b9f61d5c797f87523e4b12be6e4485a264c7e21973c1e2d2c86c" targetRef="lc_textAnnotation_442ac8ae35e4c6e53eef6013133c9feaade8fee2b5d121cb34b0ce8a1b5d53cb" /><bpmn:association id="lc_association_9b2166b4fb1e7140ae67deaadc4316790f608aeb663b9f329f08fd665c338688" associationDirection="None" sourceRef="lc_activity_a30580511dbebb50e8e45f207ff51c9853fedf295b7160fead8b017b5c79f200" targetRef="lc_textAnnotation_9b2166b4fb1e7140ae67deaadc4316790f608aeb663b9f329f08fd665c338688" /><bpmn:association id="lc_association_3d03db0cdb5928bd9c00b852866c2ce340447325f692f202718ad5d5957b095d" associationDirection="None" sourceRef="lc_activity_9ab03092f5aec19ba1527b1727f590ac3f40c53cf8e9f9b4f3de32077fa5d08a" targetRef="lc_textAnnotation_3d03db0cdb5928bd9c00b852866c2ce340447325f692f202718ad5d5957b095d" /><bpmn:association id="lc_association_fa75cc8e179110987710ea3d2335cb41797a46870539d270a17e68fc8a2deb19" associationDirection="None" sourceRef="lc_activity_189314d2e7dcc85935b2467cf09d3566d5975a808c8b57f41364ef44154097c0" targetRef="lc_textAnnotation_fa75cc8e179110987710ea3d2335cb41797a46870539d270a17e68fc8a2deb19" /><bpmn:association id="lc_association_e4425e133a41979ad7b638550cd870b7204b23d1a8efae7b8cedabfa8c5a9f4e" associationDirection="None" sourceRef="lc_activity_4f02680c95a284d7a264692faa54f5d045754cb2fa45345fb77778a6c9ed5c0e" targetRef="lc_textAnnotation_e4425e133a41979ad7b638550cd870b7204b23d1a8efae7b8cedabfa8c5a9f4e" /><bpmn:association id="lc_association_5e8227b079176b76320bb4be3167a99533cf1b08726708d2ac0a091f8a2f796b" associationDirection="None" sourceRef="lc_activity_a36b4a79a6d61e59d7eb1f458b37a674f9980f24821d20338a79ccf4292f502b" targetRef="lc_textAnnotation_5e8227b079176b76320bb4be3167a99533cf1b08726708d2ac0a091f8a2f796b" /><bpmn:association id="lc_association_a68c1febc3481de6234d50a51da4393cb18e0e65e369ab0d9bf9fa03a1a1ddd9" associationDirection="None" sourceRef="lc_activity_ba1ac6cef333477f5ad38dbb054cec5c897befa9cba9de8e32e6e66c14be1eee" targetRef="lc_textAnnotation_a68c1febc3481de6234d50a51da4393cb18e0e65e369ab0d9bf9fa03a1a1ddd9" /><bpmn:textAnnotation id="lc_textAnnotation_df8ea189fb8abccbbaedcab590fee893e2b0cb1aae141bbe7f84fec13f4dc5bd" textFormat="text/plain"><bpmn:text>Acesso simulado: não verifica credenciais nem cria conta. Autenticação real é trabalho futuro.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_fd2ca15bdf0e9c56ace2939f33a7159aad0b65ee93587d0c2f9fa5e04dfb0445" textFormat="text/plain"><bpmn:text>No navegador: PNG, JPG ou WEBP, até 10 MB.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_9115131a256655608e55c223f194604e11e30a7d8e0527503915c4660cf8e01a" textFormat="text/plain"><bpmn:text>Material autorizado e desidentificado. Sem marcar, a análise não é liberada.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_442ac8ae35e4c6e53eef6013133c9feaade8fee2b5d121cb34b0ce8a1b5d53cb" textFormat="text/plain"><bpmn:text>A API recusa imagem ilegível, menor que o mínimo ou acima de 10 MB.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_9b2166b4fb1e7140ae67deaadc4316790f608aeb663b9f329f08fd665c338688" textFormat="text/plain"><bpmn:text>Pré-processamento igual ao do treino (tamanho, cor e escala).</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_3d03db0cdb5928bd9c00b852866c2ce340447325f692f202718ad5d5957b095d" textFormat="text/plain"><bpmn:text>A IA só devolve probabilidades; a classe final e o inconclusivo são decididos pelo sistema.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_fa75cc8e179110987710ea3d2335cb41797a46870539d270a17e68fc8a2deb19" textFormat="text/plain"><bpmn:text>Oral e Cérebro: softmax, não calibrado (confiança alta não é certeza). Pele: média calibrada de 5 EfficientNet-B0.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_e4425e133a41979ad7b638550cd870b7204b23d1a8efae7b8cedabfa8c5a9f4e" textFormat="text/plain"><bpmn:text>Pele não tem inconclusivo: vira maligno a partir de 18%. Abaixo de 80% em ambas as classes, mantém a classe e mostra aviso de baixa certeza.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_5e8227b079176b76320bb4be3167a99533cf1b08726708d2ac0a091f8a2f796b" textFormat="text/plain"><bpmn:text>Só modelo, classe, confiança e horário. A imagem é descartada.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="lc_textAnnotation_a68c1febc3481de6234d50a51da4393cb18e0e65e369ab0d9bf9fa03a1a1ddd9" textFormat="text/plain"><bpmn:text>Avisos na tela: modelo experimental, baixa certeza (Pele) e o que o resultado não informa (Cérebro).</bpmn:text></bpmn:textAnnotation></bpmn:process><bpmn:process id="lc_process_e14dba3565013244991ba3e6b8669a5ac340b95b3862d34362f2fab9bcae0448" name="PixoraMed - BPMN" isExecutable="false"><bpmn:textAnnotation id="lc_text-annotation_ca5efc90df12f7557c15bf08ef5a543572dc2aefca2eff1b14541ae5680c6915" textFormat="text/plain"><bpmn:text>Processo de classificação de imagem</bpmn:text></bpmn:textAnnotation></bpmn:process><bpmndi:BPMNDiagram id="lc_diagram_deb89a90b6d80bacd3b12a5ed7dbb566ce491bdfaf50156ba95288c2c4b3796a" name="Página 1" resolution="160"><bpmndi:BPMNPlane id="lc_plane_b9e67daddff2a10c3d28d8134cff813f292ab5f8f8b8e9469b03e8076348b3e6" bpmnElement="lc_collaboration_22a71d2de2eb1a7728b1f7d7158a4081460a33f4056677156649c747755b44e8" lucid:sourcePage="lc_source-page_4bdb1f70780b390b493af34632b184f3c04aa52d113191072999cbc825acf81f"><bpmndi:BPMNShape id="lc_shape_f099dbd27f