# Modelo das variáveis do ai-service. Copie para ai-service/.env (que fica fora do git) e preencha.
# Em produção (Render), as variáveis vêm do Terraform; o .env não é usado.

# [obrigatória] Token interno que o backend envia no header X-Internal-Token.
# Precisa ser igual ao AI_SERVICE_TOKEN do backend. Em produção o Terraform gera um aleatório.
AI_SERVICE_TOKEN=troque-por-um-token-aleatorio

# [opcional] Pasta dos modelos .onnx + .json (padrão: ai-service/models)
# MODELS_DIR=models
# [opcional] Tamanho máximo da imagem em MB (padrão 10)
MAX_UPLOAD_MB=10
# [opcional] Threads do ONNX Runtime (padrão 1, bom para a pouca CPU do Render gratuito)
ONNX_THREADS=1
