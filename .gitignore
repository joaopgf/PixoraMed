# Arquivos que não vão para o git em todo o repositório (cada serviço tem também o seu .gitignore)

# Segredos
.env
*.tfvars
!*.tfvars.example

# Terraform: state e plano guardam segredos (endereço do banco com senha, tokens)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Python, Node e Java
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/
target/

# Banco SQLite local da versão antiga
data/*.db

# Editores
.idea/
.vscode/
